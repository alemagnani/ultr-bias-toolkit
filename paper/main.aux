\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces MSE decomposition (bias$^2$ + variance) under three PBM violation models. Original, min, and harmonic share identical bias$^2$ under all violations, since they are all ratio-unbiased under PBM. Clipped weights introduce additional bias.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pbm_violations}{{3}{4}{MSE decomposition (bias$^2$ + variance) under three PBM violation models. Original, min, and harmonic share identical bias$^2$ under all violations, since they are all ratio-unbiased under PBM. Clipped weights introduce additional bias}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MSE decomposition under PBM violations (anchor-item imbalance, split 80/20, ratio 50:1). Original and harmonic have comparable bias$^2$---far below clipped---while harmonic achieves 47\% lower variance under trust bias and 22\% lower under position-dependent relevance. Clipped's near-zero variance comes at the cost of $160\times $ higher bias$^2$.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:pbm_violations}{{2}{4}{MSE decomposition under PBM violations (anchor-item imbalance, split 80/20, ratio 50:1). Original and harmonic have comparable bias$^2$---far below clipped---while harmonic achieves 47\% lower variance under trust bias and 22\% lower under position-dependent relevance. Clipped's near-zero variance comes at the cost of $160\times $ higher bias$^2$}{table.caption.7}{}}
